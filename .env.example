APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- Public marketing website (docs/product/MARKETING-WEBSITE.md) ---
# MARKETING_SITE_ENABLED=true
# MARKETING_HOSTS=                     # blank = every platform host; or "getmotiongrove.com"
# MARKETING_SHOW_PLACEHOLDERS=         # blank = on outside production, off in production
# MARKETING_BOOK_DEMO_URL=             # one destination for every "Book a demo" button; blank = native /book-demo once provisioned
# MARKETING_CHECKOUT_CORE_URL=
# MARKETING_CHECKOUT_GROWTH_URL=
# MARKETING_CHECKOUT_AGENCY_URL=       # blank = the application's own signup for that plan
# MARKETING_YOUTUBE_URL=
# MARKETING_INSTAGRAM_URL=
# MARKETING_PRIVACY_URL=
# MARKETING_TERMS_URL=
# MARKETING_ACCEPTABLE_USE_URL=
# MARKETING_HELP_URL=
# MARKETING_SUPPORT_EMAIL=
# MARKETING_RATES_URL=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# Resend (HTTPS API mailer): MAIL_DRIVER/MAIL_MAILER=resend, key set in Forge only
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# RFC-001 Business Core — the onboarding wizard is ON by default (a paid V1 signup hands its Business to it).
# REQUIRE_NEW_CUSTOMERS only governs the legacy register() path; V1 signup starts its own required onboarding.
# Customers with no onboarding row are never redirected into it.
BUSINESS_ONBOARDING_ENABLED=true
BUSINESS_ONBOARDING_REQUIRE_NEW_CUSTOMERS=false
BUSINESS_ONBOARDING_ANALYSIS_QUEUE=default

# RFC-002 Opportunity Engine — disabled by default. Existing installations
# are unaffected until this is explicitly enabled.
OPPORTUNITY_ENGINE_ENABLED=false
OPPORTUNITY_ENGINE_QUEUE=default
OPPORTUNITY_RUN_TIMEOUT_MINUTES=30
OPPORTUNITY_MAX_CANDIDATES_PER_RUN=100
OPPORTUNITY_SNOOZE_SWEEP_MINUTES=15

# SEO Keyword Rank Tracking V1 (Contract 23) - PAID provider (DataForSEO). Master switch is OFF by default;
# nothing is ever sent to the provider unless this is true AND credentials are set. Money limits are micro-USD
# integers and can only be LOWERED from the documented defaults (see config/seo.php).
SEO_RANK_TRACKING_ENABLED=false
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google Ads Module V1 (docs/product/implementation-contracts/23-GOOGLE-ADS-MODULE-V1.md)
# Dedicated OAuth client for the adwords scope. Redirect must equal https://<host>/ads/oauth/callback
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT=
# "http" talks to Google. "fake" is for tests/browser acceptance and is REFUSED in production.
GOOGLE_ADS_DRIVER=http
# Optional: Google sunset developer tokens on 2026-09-09; the header is only sent when this is non-empty.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_ATTRIBUTION_CAPTURE_ENABLED=true

# Ask MotionGrove conversation history: 0 (default) keeps conversations until the customer deletes them; a positive number deletes them that many days after the last message (max 3650).
ASSISTANT_RETENTION_DAYS=0

# MotionGrove "Book a Demo" (/book-demo). See docs/product/BOOK-DEMO.md.
# Leave blank until the internal Business is provisioned; /book-demo refuses (404) until all three are set.
DEMO_BOOKING_TYPE_UUID=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional, comma-separated; blank means the request host must match the token hostname.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Native Zoom meetings (docs/product/ZOOM-MEETINGS.md) ---
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=https://<platform host>/zoom/oauth/callback   # must match the Zoom app exactly
