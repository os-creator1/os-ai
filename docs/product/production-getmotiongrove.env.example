# Environment template for PRODUCTION: https://getmotiongrove.com  (Forge -> site -> Environment)
#
# Secrets are entered in Forge ONLY. Every value below that needs one is deliberately blank or a placeholder:
# never commit a real value, never paste one into chat or a ticket, never copy one from staging.
# Anything not listed here keeps its default; the full audited list is production.env.example and
# DEPLOYMENT-READINESS.md section 3. deploy/forge/production/preflight.sh refuses a deploy when the
# values marked [GUARDED] are wrong.

APP_NAME=MotionGrove                      # [O]
APP_TITLE=MotionGrove                     # [O]
APP_ENV=production                        # [GUARDED] exactly "production"
APP_KEY=                                  # [GUARDED] NEW key: php artisan key:generate --show. Never the staging key. Never rotate.
APP_DEBUG=false                           # [GUARDED] must be explicitly false
APP_URL=https://getmotiongrove.com        # [GUARDED] exact; no trailing slash
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql                       # [GUARDED]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motiongrove_production        # [GUARDED] NEW empty database; no test/staging/dev/demo/sandbox/local in the name
DB_USERNAME=                              # [GUARDED] NEW dedicated user, not root
DB_PASSWORD=                              # [GUARDED]

QUEUE_CONNECTION=database                 # [GUARDED] never sync
CACHE_DRIVER=file                         # [GUARDED] one server; never array
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true                # [GUARDED]

# Registration. The application default is OPEN, so this MUST be set. Keep false until launch is approved.
ACCOUNT_CAN_REGISTER=false                # [GUARDED] must be present, true|false
ACCOUNT_VERIFICATION=true

# Mail: a real production mailer (SPF/DKIM/DMARC published for getmotiongrove.com).
MAIL_MAILER=smtp                          # [GUARDED] not log/array
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@getmotiongrove.com  # [GUARDED]
MAIL_FROM_NAME=MotionGrove

# Stripe: mode and keys must agree (guarded). "live" needs pk_live_/sk_live_ (or rk_live_) AND the two whsec_ secrets
# below; "test" (a rehearsal only) needs pk_test_/sk_test_ or empty. Mixed combinations are refused.
STRIPE_MODE=test                          # [GUARDED] set "live" deliberately, together with the live keys, in one edit
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PLATFORM_SUBSCRIPTION_WEBHOOK_SECRET=   # /stripe/webhook/platform-subscriptions
STRIPE_CONNECT_WEBHOOK_SECRET=                 # /stripe/webhook/business-payments (Connect)
STRIPE_AGENCY_SUBSCRIPTION_WEBHOOK_SECRET=     # /stripe/webhook/agency-subscriptions (Connect)
STRIPE_WEBHOOK_SECRET=                         # /stripe/webhook/usage-billing
USAGE_BILLING_WEBHOOK_RETENTION_DAYS=90        # unset means webhook payloads are never purged

# Off until each is deliberately approved (see FORGE-PRODUCTION.md section 11).
OPENAI_ACTIVE=false
OPENAI_API_KEY=
SEO_RANK_TRACKING_ENABLED=false
BUSINESS_ONBOARDING_ENABLED=false
BUSINESS_ONBOARDING_REQUIRE_NEW_CUSTOMERS=false
GOOGLE_ADS_DRIVER=http                    # [GUARDED] never fake
META_ADS_DRIVER=http                      # [GUARDED] never fake

# Custom-domain TLS automation is unproven (DEPLOYMENT-READINESS 1.2 C): leave blank.
FORGE_API_TOKEN=
FORGE_ORGANIZATION_SLUG=
FORGE_SERVER_ID=
FORGE_SITE_ID=
FORGE_CNAME_TARGET=
FORGE_A_RECORD_IP=
