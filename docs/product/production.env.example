# Production environment template for AI Business OS.
# See docs/product/DEPLOYMENT-READINESS.md §3 for what every key does and its class.
#
#   [R] required            the app does not boot, is insecure, or misbehaves without it
#   [O] optional            safe default; set only to tune
#   [P] provider-only       needed only if you switch that provider's feature on;
#                           blank = the feature shows its readiness state, nothing is sent
#
# No value below is a secret. Fill them in the deployed .env, never in this file.
# .env must be readable AND writable by the PHP user (Platform Settings writes it) and
# must never be inside the web root. After changing settings in the UI run:
#   php artisan config:cache

# ---------------------------------------------------------------- APP
APP_NAME="AI Business OS"           # [O]
APP_ENV=production                  # [R]
APP_KEY=                            # [R] php artisan key:generate --force (first install only; never rotate casually)
APP_DEBUG=false                     # [R]
APP_URL=https://platform.example.com   # [R] exact public https origin of the platform host
# APP_STAGE=Live                    # [O] "new" makes / answer 503 "run platform:install"
URL_FORCE_HTTPS=true                # [O] set true when TLS terminates at a proxy/CDN
SESSION_DRIVER=file                 # [O] database|redis when running more than one app server
SESSION_SECURE_COOKIE=true          # [O]
LOG_CHANNEL=daily                   # [O]
LOG_LEVEL=warning                   # [O]
# Modules that default OFF - decide deliberately:
BUSINESS_ONBOARDING_ENABLED=false
BUSINESS_ONBOARDING_REQUIRE_NEW_CUSTOMERS=false
OPPORTUNITY_ENGINE_ENABLED=false
DOCUMENTS_ENABLED=false

# ---------------------------------------------------------------- DB
DB_CONNECTION=mysql                 # [R]
DB_HOST=127.0.0.1                   # [R]
DB_PORT=3306                        # [R]
DB_DATABASE=                        # [R] a NEW empty utf8mb4 database; never an ultimatesms_testing* name
DB_USERNAME=                        # [R] least privilege (needs DDL for migrate)
DB_PASSWORD=                        # [R]

# ---------------------------------------------------------------- CACHE
CACHE_DRIVER=file                   # [R] shared by web+scheduler+workers; redis/database for >1 host; NEVER array
# REDIS_HOST=127.0.0.1              # [P] only with a Redis driver
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------------------------------------------------------------- QUEUE
QUEUE_CONNECTION=database           # [R] NOT sync (webhooks would run inline; self-dispatching jobs would recurse)
# QUEUE_FAILED_DRIVER=database-uuids   # [O]
# Do NOT set BUSINESS_ONBOARDING_ANALYSIS_QUEUE / OPPORTUNITY_ENGINE_QUEUE / DOCUMENTS_QUEUE /
# COO_INSIGHT_QUEUE: the worker only drains automation,default,batch.

# ---------------------------------------------------------------- MAIL
MAIL_MAILER=smtp                    # [R] (MAIL_DRIVER is legacy and not read)
MAIL_HOST=                          # [R]
MAIL_PORT=587                       # [R]
MAIL_USERNAME=                      # [R]
MAIL_PASSWORD=                      # [R]
MAIL_ENCRYPTION=tls                 # [R]
MAIL_FROM_ADDRESS=                  # [R]
MAIL_FROM_NAME="${APP_NAME}"        # [R]

# ---------------------------------------------------------------- STRIPE
STRIPE_MODE=live                    # [R once Stripe is on] default is "test"
STRIPE_KEY=                         # [P]
STRIPE_SECRET=                      # [P]
STRIPE_PLATFORM_SUBSCRIPTION_WEBHOOK_SECRET=   # [P] /stripe/webhook/platform-subscriptions  (lane A)
STRIPE_CONNECT_WEBHOOK_SECRET=                 # [P] /stripe/webhook/business-payments       (lane B, Connect)
STRIPE_AGENCY_SUBSCRIPTION_WEBHOOK_SECRET=     # [P] /stripe/webhook/agency-subscriptions    (lane C, Connect)
STRIPE_WEBHOOK_SECRET=                         # [P] /stripe/webhook/usage-billing           (lane D)
STRIPE_AGENCY_CONNECT_CLIENT_ID=               # [P] only for "Connect existing Stripe account"
USAGE_BILLING_WEBHOOK_RETENTION_DAYS=90        # [O, recommended] unset = webhook payloads are never purged

# ---------------------------------------------------------------- TELNYX
TELNYX_MODE=live                    # [R once Telnyx is on] default is "sandbox"
TELNYX_API_KEY=                     # [P]
TELNYX_WEBHOOK_PUBLIC_KEY=          # [P]
MANAGED_MESSAGING_ENABLED=false             # [O] default false
MANAGED_MESSAGING_PROVISIONING_ENABLED=false   # [O] default false

# ---------------------------------------------------------------- GOOGLE / MICROSOFT
# Redirect URIs are https://<APP_URL host>/ + the path in the comment.
GOOGLE_CLIENT_ID=                   # [P] sign-in only
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=                    #     /login/google/callback
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=  # [P]
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REDIRECT=   #     /gbp/oauth/callback
GOOGLE_ADS_CLIENT_ID=               # [P]
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT=                #     /ads/oauth/callback
GOOGLE_ADS_DRIVER=http              # [O] "fake" THROWS in production
# GOOGLE_ADS_DEVELOPER_TOKEN=       # [O] sent only when non-empty
GOOGLE_CALENDAR_CLIENT_ID=          # [P]
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT=           #     /calendar-connection/oauth/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=       # [P]
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT=        #     /calendar-connection/oauth/outlook/callback
BUSINESS_EMAIL_GOOGLE_CLIENT_ID=    # [P]
BUSINESS_EMAIL_GOOGLE_CLIENT_SECRET=
BUSINESS_EMAIL_GOOGLE_REDIRECT=     #     /email/oauth/google/callback
BUSINESS_EMAIL_MICROSOFT_CLIENT_ID= # [P]
BUSINESS_EMAIL_MICROSOFT_CLIENT_SECRET=
BUSINESS_EMAIL_MICROSOFT_REDIRECT=  #     /email/oauth/microsoft/callback

# ---------------------------------------------------------------- META
META_ADS_APP_ID=                    # [P]
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=              #     /ads/meta/oauth/callback
META_ADS_DRIVER=http                # [O] "fake" THROWS in production

# ---------------------------------------------------------------- DATAFORSEO
SEO_RANK_TRACKING_ENABLED=false     # [O] PAID provider; fail-closed master switch
DATAFORSEO_LOGIN=                   # [P]
DATAFORSEO_PASSWORD=                # [P]

# ---------------------------------------------------------------- FILES / STORAGE
FILESYSTEM_DISK=local               # [O] uploads live under public/images/* and public/mms, not S3
# AWS_ACCESS_KEY_ID=                # [P] S3 only
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=

# ---------------------------------------------------------------- WEBHOOKS / OTHER PROVIDERS
PLATFORM_AUTOMATION_WEBHOOK_SECRET= # [P] signs Platform Automation "Call a webhook" steps
FORGE_API_TOKEN=                    # [P] custom-domain certificates (Laravel Forge only)
FORGE_ORGANIZATION_SLUG=            # [P]
FORGE_SERVER_ID=                    # [P]
FORGE_SITE_ID=                      # [P]
FORGE_CNAME_TARGET=                 # [R to offer custom domains] DNS instructions shown to owners (not secret)
FORGE_A_RECORD_IP=                  # [R to offer custom domains]
OPENAI_ACTIVE=false                 # [P] master switch, default false
OPENAI_API_KEY=                     # [P]
