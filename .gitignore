.env
.env.*
!.env.example

/vendor
/node_modules

# Generated by `composer install` (post-autoload-dump -> artisan
# package:discover) and by artisan config:cache/route:cache. These are
# LOCAL build state, not source: every fresh checkout regenerates them,
# and the copies that used to be tracked here were stale — they omitted
# the blade-ui-kit/blade-icons, laravel/sentinel and
# technikermathe/blade-lucide-icons providers, so restoring them broke
# icon and provider bindings. They also embed absolute class paths, so a
# copied vendor/ directory could leave them pointing into another
# worktree.
/bootstrap/cache/packages.php
/bootstrap/cache/services.php
/bootstrap/cache/config.php
/bootstrap/cache/routes-v7.php
/bootstrap/cache/events.php

/public/hot
/public/storage
/storage/*.key
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*

.phpunit.result.cache
.phpunit.cache
.idea
.vscode
.DS_Store
Thumbs.db

/storage/*.xlsx
/storage/cronJobAvailable
/storage/installed
/storage/lock
/storage/tmp/*
!/storage/tmp/.keep

/naujas/